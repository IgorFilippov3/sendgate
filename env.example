# SendGate environment variables. Every value is optional.

# --- Security ---
# API key for /api/v2/*. If not set, the API is disabled (the web UI still works).
SENDGATE_API_KEY=your_secret_api_key_here
# Requests per minute per client (web UI) or per API key. 0 disables. Default: 30
RATE_LIMIT_PER_MINUTE=30

# --- App ---
APP_VERSION=0.2.0
APP_BASE_URL=http://localhost:3000
PORT=3000

# --- Limits ---
# Max emails per batch (web CSV upload and /api/v2/verify/batch). Default: 100
MAX_BULK_EMAILS=100
MAX_FILE_SIZE_MB=5
# Domains analysed in parallel within one batch. Default: 8
DOMAIN_CONCURRENCY=8

# --- SMTP mailbox verification ---
# Checks that a mailbox exists by asking its mail server (EHLO, MAIL FROM,
# RCPT TO, QUIT). No message is ever sent. Requires a host where outbound
# port 25 is open (not Vercel), and a hostname with matching A and PTR records.
# See docs/deploy.md.
SMTP_PROBE_ENABLED=false
# Hostname used in EHLO. Required when SMTP_PROBE_ENABLED=true.
SMTP_HELO_NAME=verify.example.com
# Envelope sender. Default: verify@<SMTP_HELO_NAME>
SMTP_MAIL_FROM=
SMTP_CONNECT_TIMEOUT=8000
SMTP_COMMAND_TIMEOUT=10000
# Max simultaneous SMTP sessions. Keep it low to protect your IP reputation.
SMTP_CONCURRENCY=5
SMTP_MAX_RCPT_PER_SESSION=20
SMTP_STARTTLS=true

# --- DNS ---
# Comma-separated resolvers. Empty = system resolver (recommended: Spamhaus
# refuses blocklist queries that arrive through 8.8.8.8 / 1.1.1.1).
DNS_SERVERS=
DNS_TIMEOUT=2500
DNS_RETRIES=2
# Seconds to cache per-domain results. 0 disables. Default: 900
DOMAIN_CACHE_TTL=900
DOMAIN_CACHE_SIZE=5000

# --- Disposable domains ---
# A list of ~10,000 domains is bundled; this keeps it fresh at runtime.
DISPOSABLE_AUTO_UPDATE=true
DISPOSABLE_UPDATE_INTERVAL_HOURS=24
DISPOSABLE_SOURCE_URL=https://raw.githubusercontent.com/disposable-email-domains/disposable-email-domains/main/disposable_email_blocklist.conf

# --- Reputation ---
# Free Spamhaus Data Query Service key (https://www.spamhaus.com/free-trial/).
# When set, Spamhaus lists are queried through DQS and work with any resolver.
SPAMHAUS_DQS_KEY=
# Override blocklist zones (comma-separated).
# DOMAIN_BLOCKLISTS=dbl.spamhaus.org
# IP_BLOCKLISTS=zen.spamhaus.org,bl.spamcop.net
# Domains younger than this are flagged as new. Default: 30
DOMAIN_AGE_THRESHOLD_DAYS=30
RDAP_ENABLED=true
RDAP_TIMEOUT=3000
